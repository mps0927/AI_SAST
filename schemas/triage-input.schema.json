{
  "$defs": {
    "AgentContext": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentName"
        },
        "available_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Available Chunk Ids",
          "type": "array"
        },
        "batch_id": {
          "title": "Batch Id",
          "type": "string"
        },
        "budget_snapshot": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Budget Snapshot",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "input_message_ids": {
          "items": {
            "type": "string"
          },
          "title": "Input Message Ids",
          "type": "array"
        },
        "phase": {
          "default": 0,
          "title": "Phase",
          "type": "integer"
        },
        "risk_tags": {
          "items": {
            "type": "string"
          },
          "title": "Risk Tags",
          "type": "array"
        },
        "scenario": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "agent",
        "batch_id",
        "scenario"
      ],
      "title": "AgentContext",
      "type": "object"
    },
    "AgentName": {
      "enum": [
        "TRIAGE",
        "INVESTIGATOR",
        "CHALLENGER",
        "JUDGE"
      ],
      "title": "AgentName",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "CONFIRMED",
        "REJECTED",
        "INCONCLUSIVE"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/AgentContext"
    },
    "focus_evidence_id": {
      "title": "Focus Evidence Id",
      "type": "string"
    },
    "security_sketch_code": {
      "title": "Security Sketch Code",
      "type": "string"
    }
  },
  "required": [
    "context",
    "focus_evidence_id",
    "security_sketch_code"
  ],
  "title": "TriageInput",
  "type": "object",
  "x-agent-role": "TRIAGE"
}
